/* NOT Gate (Inverte DFF2) */
(symbol
	(rect 680 340 728 372)
	(text "NOT" (rect 1 0 21 10)(font "Arial" (font_size 6)))
	(text "not1" (rect 3 21 26 33)(font "Arial" ))
	(port
		(pt 0 16)
		(input)
		(text "IN" (rect 2 7 13 19)(font "Courier New" (bold))(invisible))
		(line (pt 0 16)(pt 13 16))
	)
	(port
		(pt 48 16)
		(output)
		(text "OUT" (rect 32 7 49 19)(font "Courier New" (bold))(invisible))
		(line (pt 39 16)(pt 48 16))
	)
	(drawing
		(line (pt 13 25)(pt 13 7))
		(line (pt 13 7)(pt 31 16))
		(line (pt 13 25)(pt 31 16))
		(circle (rect 31 12 39 20))
	)
)

/* AND2 Gate (Detector Borda de Subida) */
(symbol
	(rect 770 310 818 342)
	(text "AND2" (rect 1 0 25 10)(font "Arial" (font_size 6)))
	(text "and1" (rect 3 21 26 33)(font "Arial" ))
	(port
		(pt 0 8)
		(input)
		(text "IN1" (rect 2 0 17 12)(font "Courier New" (bold))(invisible))
		(line (pt 0 8)(pt 16 8))
	)
	(port
		(pt 0 24)
		(input)
		(text "IN2" (rect 2 16 17 28)(font "Courier New" (bold))(invisible))
		(line (pt 0 24)(pt 16 24))
	)
	(port
		(pt 48 16)
		(output)
		(text "OUT" (rect 27 8 44 20)(font "Courier New" (bold))(invisible))
		(line (pt 32 16)(pt 48 16))
	)
	(drawing
		(line (pt 16 4)(pt 24 4))
		(line (pt 16 28)(pt 24 28))
		(line (pt 16 4)(pt 16 28))
		(arc (pt 24 4)(pt 32 16)(rect 16 4 32 28))
		(arc (pt 24 28)(pt 32 16)(rect 16 4 32 28))
	)
)

